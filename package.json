{
  "name": "@lyndon/frontend-code-spec",
  "version": "3.2.0",
  "private": true,
  "description": "为业务仓提供可安装的前端代码规范：自定义 ESLint 规则集 + 全链路 lint 工具链 + 工具判不了的写法约定 + 请求层范式样板",
  "license": "MIT",
  "author": {
    "name": "Lyndon",
    "email": "wuxianzhi052@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": "./eslint/index.js",
    "./configs/*": "./eslint/configs/*.js",
    "./rules/*": "./eslint/rules/*.js",
    "./constants/*": "./eslint/constants/*.js",
    "./utils/*": "./eslint/utils/*.js",
    "./package.json": "./package.json",
    "./stylelint": "./.stylelintrc.js",
    "./prettier": "./prettier.config.js",
    "./ls-lint.yml": "./.ls-lint.yml"
  },
  "files": [
    "eslint",
    ".stylelintrc.js",
    "prettier.config.js",
    ".ls-lint.yml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:filename": "ls-lint",
    "lint:fix": "eslint . --fix",
    "lint:md": "zhlint \"{**,.agents/rules/**,.github/**,.gitlab/**}/*.md\"",
    "lint:md:fix": "zhlint \"{**,.agents/rules/**,.github/**,.gitlab/**}/*.md\" --fix",
    "lint:pkg": "sort-package-json --check",
    "lint:style": "stylelint \"**/*.{scss,css}\" --allow-empty-input",
    "lint:style:fix": "stylelint \"**/*.{scss,css}\" --fix --allow-empty-input",
    "prepare": "husky",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm lint && pnpm lint:filename && pnpm lint:style && pnpm lint:md && pnpm lint:pkg && pnpm format:check && pnpm test:cov"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint-react/eslint-plugin": "5.28.4",
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-no-barrel-files": "2.3.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "^17.8.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript-eslint": "8.72.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-istanbul": "4.1.12",
    "@vitest/coverage-v8": "^4.1.2",
    "antd": "^6.5.3",
    "axe-core": "4.14.0",
    "axios": "^1.19.0",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "zhlint": "^0.8.2"
  },
  "peerDependencies": {
    "eslint": ">=10.0.0",
    "prettier": ">=3.0.0",
    "stylelint": ">=17.0.0",
    "typescript": ">=5.6.0"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.12.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
