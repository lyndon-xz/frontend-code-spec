{
  "name": "@lyndon/frontend-code-spec",
  "version": "1.0.0",
  "private": true,
  "description": "前端 code-spec：ESLint 规则防线 + 请求层基础设施范式",
  "keywords": [
    "code-quality",
    "coding-standards",
    "eslint",
    "request-layer",
    "enterprise"
  ],
  "license": "MIT",
  "author": {
    "name": "Lyndon",
    "email": "wuxianzhi052@gmail.com"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{json,yml,yaml,md,scss,css,html}\" --ignore-unknown",
    "lint": "eslint .",
    "lint:filename": "ls-lint",
    "lint:fix": "eslint . --fix",
    "lint:md": "zhlint \"{**,.*/**}/*.md\"",
    "lint:md:fix": "zhlint \"{**,.*/**}/*.md\" --fix",
    "lint:pkg": "sort-package-json --check",
    "lint:style": "stylelint \"**/*.scss\" --allow-empty-input",
    "lint:style:fix": "stylelint \"**/*.scss\" --fix --allow-empty-input",
    "prepare": "husky",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "antd": "^6.5.2",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "^22",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.33.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.5",
    "prettier": "^3.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "sort-package-json": "^3.6.1",
    "stylelint": "^17.4.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.2",
    "zhlint": "^0.8.2"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
