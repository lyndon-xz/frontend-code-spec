{
  "name": "@lyndon/frontend-code-spec",
  "version": "2.0.0",
  "private": true,
  "description": "为业务仓库制定 lint 规则与代码写法的源头仓库：自定义 ESLint 规则集 + 全链路 lint 工具链 + 请求层范式样板，不发布为 npm 包",
  "license": "MIT",
  "author": {
    "name": "Lyndon",
    "email": "wuxianzhi052@gmail.com"
  },
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{json,yml,yaml,md,scss,css,html}\" --ignore-unknown",
    "lint": "eslint .",
    "lint:filename": "ls-lint",
    "lint:fix": "eslint . --fix",
    "lint:md": "zhlint \"{**,.*/**}/*.md\"",
    "lint:md:fix": "zhlint \"{**,.*/**}/*.md\" --fix",
    "lint:pkg": "sort-package-json --check",
    "lint:style": "stylelint \"**/*.scss\" --allow-empty-input",
    "lint:style:fix": "stylelint \"**/*.scss\" --fix --allow-empty-input",
    "prepare": "husky",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm lint && pnpm lint:filename && pnpm lint:style && pnpm lint:pkg && pnpm format:check && vitest run"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.5",
    "@ls-lint/ls-lint": "^2.3.1",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.2",
    "antd": "^6.5.3",
    "axios": "^1.19.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.8",
    "sort-package-json": "^4.0.0",
    "stylelint": "^17.4.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "zhlint": "^0.8.2"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.12.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}
